POSTGRES_HOST=db
CONTAINER_NAME=commerce_api
PORT=3015
REDIS_URL=redis://redis:6379

POSTGRES_NAME=commerce_db
POSTGRES_PORT=5432
# If port 5432 is already in use by a local PostgreSQL on your host, change POSTGRES_HOST_PORT (e.g. 5433)
POSTGRES_HOST_PORT=5432
POSTGRES_USER=test
POSTGRES_PASSWORD=test
POSTGRES_DB=commerce_db

SONARQUBE_PORT=9000
SONARQUBE_HOST_URL=http://localhost:9000/api/system/status

# Replace with a unique random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

AWS_REGION=us-east-1
AWS_S3_BUCKET=comercial-360-bucket
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Replace with a unique random value of at least 32 characters.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3015
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800

# Optional first-run administrator bootstrap. Configure both, then remove them
# after the account has been created.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrador

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=local-dev
SMTP_PASSWORD=local-dev
SMTP_FROM=RIWI Commerce <no-reply@localhost>

# Leave these empty until a real Microsoft Entra application is configured.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
