POSTGRES_HOST=db
CONTAINER_NAME=commerce_api
PORT=3015

POSTGRES_NAME=commerce_db
POSTGRES_PORT=5432
# If port 5432 is already in use by a local PostgreSQL on your host, change POSTGRES_HOST_PORT (e.g. 5433)
POSTGRES_HOST_PORT=5432
POSTGRES_USER=test
POSTGRES_PASSWORD=test
POSTGRES_DB=commerce_db
# Production (Amazon RDS): POSTGRES_HOST is the RDS endpoint, POSTGRES_SSL=true and
# POSTGRES_SSL_CA the RDS bundle: curl -o certs/rds-global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
POSTGRES_SSL=false
POSTGRES_SSL_CA=

SONARQUBE_PORT=9000
SONARQUBE_HOST_URL=http://localhost:9000/api/system/status

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h

AWS_REGION=us-east-1
AWS_S3_BUCKET=comercial-360-bucket
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

BETTER_AUTH_SECRET=change-me-to-a-secure-random-secret
BETTER_AUTH_URL=http://localhost:3015
# Origin of the frontend (CORS with credentials, reset/sign-in redirects)
FRONTEND_URL=http://localhost:3000

# HU-09: sender verified in Amazon SES for the password reset email.
# Leave empty to only log the reset link (local development).
AWS_SES_FROM_EMAIL=

# HU-10: Microsoft 365 sign-in (Azure app registration). Leave empty to disable.
# Redirect URI to register in Azure: ${BETTER_AUTH_URL}/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# HU-42: password of every user created by `npm run seed:demo`
DEMO_PASSWORD=
